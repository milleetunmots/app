<div id="update" class="module-selection">
  <div class="container" id="update-content">
    <div id="logos">
      <%= image_tag("registration/logo-1001mots.png", id: "mots-logo", alt: "1001mots") %>
    </div>

    <%= simple_form_for @children_support_module, url: @action_path do |f| %>
      <%= f.error_notification message: "Une erreur est survenue, veuillez transmettre votre choix à votre accompagnante, nous sommes désolé pour la gêne occasionnée." %>

      <% if @children_support_module.support_module_id %>
        <h1>Mauvaise nouvelle : il est trop tard pour choisir un thème mais…</h1>
        <p class="module-selection-lead">Bonne nouvelle : on en a choisi un pour vous !</p>
        <div class="module-selection-body">
        <div class="module-grid module-grid--single">
          <div class="module-card module-card--chosen">
            <%= render 'module_picture', support_module: @support_module_selected.decorate %>
            <span class="module-card-choice">
              <span class="module-card-name"><%= @support_module_selected.name %></span>
            </span>
          </div>
        </div>
        <p class="module-selection-lead">Vous recevrez le livre et les SMS de ce thème d’ici 2 ou 3 semaines. A bientôt !</p>
        </div>
      <% else %>
        <h1>Sur quel thème voulez-vous recevoir des conseils (et un livre) ?</h1>
        <div class="module-selection-body">
        <div class="module-grid">
          <% @support_modules.each do |support_module| %>
            <label class="module-card">
              <%= render 'module_picture', support_module: support_module %>
              <span class="module-card-choice">
                <input type="radio" name="children_support_module[support_module_id]" value="<%= support_module.id %>" required>
                <span class="module-card-name"><%= support_module.name %></span>
              </span>
            </label>
          <% end %>
          <label class="module-card">
            <%= render 'module_picture', support_module: nil %>
            <span class="module-card-choice">
              <input type="radio" name="children_support_module[support_module_id]" value="" required>
              <span class="module-card-name">Je laisse 1001mots choisir pour moi</span>
            </span>
          </label>
        </div>

        <div class="module-selection-submit">
          <button type="submit" class="btn btn-lg" id="parent-form-submit">Choisir</button>
        </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
