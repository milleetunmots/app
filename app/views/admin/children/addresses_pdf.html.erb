<div class="addresses">

  <% @children.each_slice(3) do |children_slice| %>

    <% children_slice.each do |child| %>

      <div class="address">
        <div class="address-content <%= child.label_size_class %>">
          <% if child.label_heading_line %>
            <div class="address-heading"><%= child.label_heading_line %></div>
          <% end %>
          <div class="address-body"><%= safe_join(child.label_body_lines, tag.br) %></div>
        </div>
      </div>

    <% end %>

    <% (3 - children_slice.count).times do |child| %>
      <div class="address"></div>
    <% end %>

    <% children_slice.each do |child| %>

      <%# Ordre d'empilement voulu : l'icône, l'ombre, puis le cartouche qui les recouvre %>
      <div class="gift-card">
        <%= @debug ? image_tag('gift-1001mots.png', class: 'gift-card-icon') : wicked_pdf_image_tag('gift-1001mots.png', class: 'gift-card-icon') %>
        <div class="gift-card-shadow"></div>
        <div class="gift-card-label">
          <div class="gift-card-intro">Un livre pour</div>
          <div class="gift-card-name"><%= child.first_name %></div>
        </div>
      </div>

    <% end %>

  <% end %>

</div>
