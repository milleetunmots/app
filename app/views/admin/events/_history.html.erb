<div class="chat-history">

  <div class="chat-legend">
    <p><span class="dot rcs"></span> Format RCS : vous pouvez savoir si le message a été <strong>ouvert</strong> par le parent.</p>
    <p><span class="dot sms"></span> Format SMS : on sait si le message a été <strong>reçu</strong>, mais pas s'il a été ouvert.</p>
  </div>

  <% events.each do |event| %>

    <% if event.model.is_a?(Events::TextMessage) %>

      <div class="chat-message <%= event.originated_by_app ? 'outgoing' : 'incoming' %>">

        <div class="bubble <%= event.chat_bubble_class %>"><%= event.body %></div>

        <% if event.originated_by_app %>
          <% status = event.chat_status %>
          <div class="meta <%= status[:css_class] %>">
            <i class="<%= status[:icon] %>"></i>
            <span class="label"><%= status[:label] %></span>
            <span class="sep">·</span> <%= event.timeline_occurred_at %>
            <span class="sep">·</span> <%= link_to 'Détails', admin_sent_by_app_text_message_path(event), class: 'admin-link' %>
          </div>
        <% else %>
          <div class="meta">
            <i class="fas fa-user"></i>
            <%= event.chat_sender %>
            <span class="sep">·</span> <%= event.timeline_occurred_at %>
            <span class="sep">·</span> <%= link_to 'Détails', admin_events_text_message_path(event), class: 'admin-link' %>
          </div>
        <% end %>

      </div>

    <% else %>

      <div class="chat-message outgoing">

        <div class="bubble neutral">
          <% if event.model.is_a?(Events::WorkshopParticipation) %>
            <%= event.comments %>
          <% else %>
            <%= event.body %>
          <% end %>
        </div>

        <div class="meta">
          <span class="system-title"><%= event.timeline_description %></span>
          <%= event.timeline_occurred_at %>
          <span class="sep">·</span> <%= link_to 'Détails', [:admin, event], class: 'admin-link' %>
        </div>

      </div>

    <% end %>

  <% end %>

</div>
