<div id="update" class="module-selection">
  <div class="container" id="update-content">
    <div id="logos">
      <%= image_tag("registration/logo-1001mots.png", id: "mots-logo", alt: "1001mots") %>
    </div>

    <%= form_with url: survey_parent_answers_path(@survey, @parent), method: :post, local: true do |f| %>
      <%= hidden_field_tag :question_id, @question.id %>
      <%= hidden_field_tag :child_id, @child.id %>
      <%= hidden_field_tag :sc, params[:sc] %>

      <h1><%= @question.name.gsub('{PRENOM_ENFANT}', @child.first_name) %></h1>

      <div class="module-selection-body">
        <% if @question.with_open_ended_response %>
          <div class="module-selection-text">
            <%= text_area_tag :response, nil, rows: 5, class: 'form-control' %>
          </div>
        <% else %>
          <div class="module-grid">
            <% @books.each do |book| %>
              <label class="module-card">
                <span class="module-card-picture">
                  <% if book.media&.file.present? %>
                    <%= image_tag(book.media.file, alt: "") %>
                  <% end %>
                </span>
                <span class="module-card-choice">
                  <input type="radio" name="response" value="<%= book.id %>" required>
                  <span class="module-card-name"><%= book.title %></span>
                </span>
              </label>
            <% end %>
            <label class="module-card">
              <span class="module-card-picture module-card-picture--empty"></span>
              <span class="module-card-choice">
                <input type="radio" name="response" value="did_not_get_books" required>
                <span class="module-card-name">Je n’ai reçu aucun de ces livres</span>
              </span>
            </label>
          </div>
        <% end %>

        <div class="module-selection-submit">
          <%= f.submit "Continuer", class: "btn btn-lg", id: "parent-form-submit" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
